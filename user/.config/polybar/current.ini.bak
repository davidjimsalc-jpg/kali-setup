;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

;; Global WM Settings

[global/wm]
margin-bottom = 0
margin-top = 0

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

;; File Inclusion

include-file = ~/.config/polybar/colors.ini

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

;; Bar Settings

[bar/main]
monitor =
monitor-fallback =
monitor-strict = false

bottom = false
fixed-center = true

width = 98%
height = 40
offset-x = 1%
offset-y = 15

background = ${color.bg}
foreground = ${color.fg}

radius-top = 12
radius-bottom = 12

line-size = 0
border-bottom-size = 0
border-color = ${color.ac}

padding-left = 2
padding-right = 2
module-margin-left = 1
module-margin-right = 1

font-0 = "Iosevka Nerd Font:size=13;3"
font-1 = "Iosevka Nerd Font:bold:size=24;2"
font-2 = "Iosevka Nerd Font:size=22;6"
font-3 = "Source Code Pro:size=10;3"
font-4 = "Montserrat Medium:style=Medium:size=12;3"
font-5 = "Helvetica Rounded:style=Bold:size=10.5;3"
font-6 = "Hurmit Nerd Font Mono:style=medium:pixelsize=17;3"

separator =
dim-value = 1.0
wm-name = polybar
locale =
tray-position = none
wm-restack = bspwm
enable-ipc = true

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

;; Primary bar
;; Left: Kali | time | local IP | VPN IP
;; Center: bspwm workspaces
;; Right: custom apps | volume | network | power-status | power menu

[bar/primary]
inherit = bar/main
modules-left = kali date local_ip vpn_ip
modules-center = bspwm
modules-right = kitty browser files volume network power-status power

;; Kept to preserve the original structure.
;; These bars are not launched by launch.sh unless you explicitly add them.

[bar/secondary]
inherit = bar/main
width = 7%
height = 40
offset-x = 3.8%
offset-y = 15
modules-center = date

[bar/log]
format-volume = <label-volume>
label-volume =  %percentage%%
label-volume-padding = 1

format-muted = <label-muted>
label-muted =  muted
label-muted-padding = 1

click-right = pavucontrol &

;; Network
;; VMware exposes the guest NIC as eth0, so this intentionally shows
;; a network/Wi-Fi-style icon without trying to print an ESSID.

[module/network]
type = internal/network
interface = eth0
interval = 3
accumulate-stats = true
unknown-as-up = true

format-connected = <label-connected>
label-connected = 
label-connected-padding = 1

format-disconnected = <label-disconnected>
label-disconnected = x
label-disconnected-padding = 1

;; "Power supply" indicator.
;; A real battery module is intentionally not used because VMware does not
;; expose a usable BAT*/capacity interface in this VM.

[module/power-status]
type = custom/text
format = 
format-padding = 1

;; Power menu

[module/power]
type = custom/text
format = 
format-padding = 1
click-left = ~/.config/polybar/scripts/powermenu_alt &

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

;; Compatibility / original auxiliary modules
;; Kept so the old bar sections and scripts can still be reused.

[module/my-text-label]
type = custom/text
format = K

[module/mpd]
type = internal/mpd
interval = 2
format-online = <label-song>
format-online-foreground = ${color.fg}
label-song = "%title%"
label-song-maxlen = 12
label-song-ellipsis = true
label-offline = "Offline"

[module/term]
type = custom/text
format = 
click-left = kitty &

[module/web]
type = custom/text
format = 
click-left = firefox-esr &

[module/edit]
type = custom/text
format = 
click-left = geany &

[module/apps]
type = custom/text
format = 
click-left = ~/.config/polybar/scripts/launcher &

[module/sep]
type = custom/text
format = " | "

[module/sep2]
type = custom/text
format = "   "

[module/alsa]
type = internal/alsa
format-volume = <label-volume>
format-muted = <label-muted>
label-volume =  %percentage%%
label-muted =  muted
click-right = pavucontrol &

[module/sysmenu]
type = custom/text
format = 
click-left = ~/.config/polybar/scripts/powermenu_alt &

